  "scenarios": [
    {
      "id": "ats-mains-healthy",
      "name": "Nguồn lưới bình thường, cấp tải chính",
      "reference": "Tiêu chuẩn ATS - TCVN / IEC 60947-6-1",
      "initialSummary": "Lưới và máy phát đều có nguồn, PR1 kiểm tra pha đạt",
      "initial": [],
      "steps": [
        {
          "label": "Trạng thái ưu tiên nguồn lưới",
          "expect": [
            { "device": "pr_grid", "key": "healthy", "value": true },
            { "device": "mc_mains", "key": "active", "value": true },
            { "device": "nc_km_m", "key": "closed", "value": false },
            { "device": "mc_gen", "key": "active", "value": false },
            { "device": "load_motor", "key": "running", "value": true },
            { "device": "hl_mains", "key": "active", "value": true }
          ]
        }
      ]
    },
    {
      "id": "ats-transfer-to-gen",
      "name": "Mất pha lưới, tự động chuyển sang máy phát",
      "reference": "Tiêu chuẩn ATS - TCVN / IEC 60947-6-1",
      "initialSummary": "Lưới gặp sự cố mất pha L1, chuyển nguồn sang máy phát sau trễ KT_G",
      "initial": [
        { "device": "pr_grid", "key": "faultMode", "value": "LOSS_L1" }
      ],
      "steps": [
        {
          "label": "Chuyển nguồn tự động sang máy phát",
          "advanceMs": 1500,
          "expect": [
            { "device": "pr_grid", "key": "healthy", "value": false },
            { "device": "hl_flt", "key": "active", "value": true },
            { "device": "mc_mains", "key": "active", "value": false },
            { "device": "nc_km_m", "key": "closed", "value": true },
            { "device": "mc_gen", "key": "active", "value": true },
            { "device": "load_motor", "key": "running", "value": true },
            { "device": "hl_gen", "key": "active", "value": true }
          ]
        }
      ]
    }
  ]
}