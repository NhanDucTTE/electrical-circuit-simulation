  "scenarios": [
    {
      "id": "pressure-cycle",
      "name": "Vòng 4–20 mA và ngõ ra OUT1",
      "verification": "verified",
      "reference": "Mạch minh họa · Sensys 0–10 bar / 4–20 mA, E5EC ở chế độ ON/OFF tác động thuận, điểm đặt 5 bar.",
      "initialDescription": "AC1 và DC1 bật. TR1 cấp 110 VAC cho PIC1 và đèn HL1.",
      "initial": [],
      "steps": [
        {
          "label": "Áp suất 0 bar",
          "actions": [
            {
              "device": "pt",
              "key": "pressureBar",
              "value": 0
            }
          ],
          "expect": [
            {
              "device": "pt",
              "key": "currentMa",
              "value": 4
            },
            {
              "device": "pic",
              "key": "pv",
              "value": 0
            },
            {
              "device": "pic",
              "key": "active",
              "value": false
            },
            {
              "device": "light",
              "key": "active",
              "value": false
            }
          ]
        },
        {
          "label": "Áp suất 5.5 bar",
          "actions": [
            {
              "device": "pt",
              "key": "pressureBar",
              "value": 5.5
            }
          ],
          "expect": [
            {
              "device": "pt",
              "key": "currentMa",
              "value": 12.8
            },
            {
              "device": "pic",
              "key": "pv",
              "value": 5.5
            },
            {
              "device": "pic",
              "key": "active",
              "value": true
            },
            {
              "device": "light",
              "key": "active",
              "value": true
            }
          ]
        },
        {
          "label": "Áp suất 10 bar",
          "actions": [
            {
              "device": "pt",
              "key": "pressureBar",
              "value": 10
            }
          ],
          "expect": [
            {
              "device": "pt",
              "key": "currentMa",
              "value": 20
            },
            {
              "device": "pic",
              "key": "pv",
              "value": 10
            },
            {
              "device": "pic",
              "key": "active",
              "value": true
            },
            {
              "device": "light",
              "key": "active",
              "value": true
            }
          ]
        },
        {
          "label": "Áp suất 1 bar",
          "actions": [
            {
              "device": "pt",
              "key": "pressureBar",
              "value": 1
            }
          ],
          "expect": [
            {
              "device": "pt",
              "key": "currentMa",
              "value": 5.6
            },
            {
              "device": "pic",
              "key": "pv",
              "value": 1
            },
            {
              "device": "pic",
              "key": "active",
              "value": false
            },
            {
              "device": "light",
              "key": "active",
              "value": false
            }
          ]
        },
        {
          "label": "Cắt nguồn vòng đo",
          "actions": [
            {
              "device": "supply",
              "key": "on",
              "value": false
            }
          ],
          "expect": [
            {
              "device": "pic",
              "key": "sensorFault",
              "value": true
            },
            {
              "device": "light",
              "key": "active",
